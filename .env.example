# Safe default: only fictional local records are searched.
VITE_SEARCH_ADAPTER=mock
VITE_LIVE_API_ENABLED=false

# Convex CLI generates the real value in .env.local after `npx convex dev`.
# This URL is public client configuration, not a secret.
VITE_CONVEX_URL=

# Configure these only for a reviewed, authorized server-side proxy.
# Do not put API keys, bearer tokens, bot tokens, or other secrets in VITE_* variables.
# The proxy must return the canonical schema documented in README.md.
VITE_API_BASE_URL=
VITE_API_PHONE_ROUTE=
VITE_API_IDENTITY_ROUTE=
VITE_API_QUERY_PARAMETER=
VITE_API_TIMEOUT_MS=8000
