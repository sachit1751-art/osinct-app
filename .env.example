# Search is sent to one configured HTTP endpoint and remains disabled until configured.
VITE_LIVE_API_ENABLED=false

# Convex CLI generates the real value in .env.local after `npx convex dev`.
# This URL is public client configuration, not a secret.
VITE_CONVEX_URL=

# Configure these only for a reviewed, authorized API returning non-sensitive data.
# Do not put API keys, bearer tokens, bot tokens, or other secrets in VITE_* variables.
VITE_API_BASE_URL=
VITE_API_ROUTE=search
VITE_API_QUERY_PARAMETER=q
VITE_API_TIMEOUT_MS=8000
# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:upbeat-marmot-304 # team: sachit-98fa5, project: osinct-app

VITE_CONVEX_URL=https://upbeat-marmot-304.convex.cloud

VITE_CONVEX_SITE_URL=https://upbeat-marmot-304.convex.site
